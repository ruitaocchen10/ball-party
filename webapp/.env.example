# Copy to .env.local and fill in from Supabase Dashboard → Project Settings → API.
# Both values are safe to expose to the browser; RLS is what protects the data.

NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co

# The publishable key (sb_publishable_...). Legacy projects call this the anon key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Absolute base URL for OAuth and email-confirmation redirects. Set this in
# production — without it we fall back to the request host, and on Vercel that
# bakes a per-deployment preview URL into confirmation emails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Local dev only, read by `npm run admin:sync-local` — not by the app. Who counts
# as a prompt admin is the prompts_private.admin_config table (the same list the
# create/resolve/void RPCs check); this comma-separated list just seeds it in your
# local database. In production, insert admins into that table directly.
PROMPTS_ADMIN_EMAILS=

# PostHog product analytics (US cloud). The project API key (phc_...) is meant
# to be public; it can only send events. Leave it unset and analytics is off:
# nothing is loaded in the browser and no server events are sent.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
