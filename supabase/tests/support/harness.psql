-- Shared fixtures for the pgTAP suites. Included with \ir, not run on its own —
-- it lives under support/ so `supabase test db supabase/tests` does not try to
-- treat it as a test file.
--
-- The suites run partly as `authenticated` so that RLS is exercised the way a
-- player experiences it, and partly as the owner so fixtures can be built.
-- tests.act_as and tests.act_as_admin switch between the two.

create schema tests;
create table tests.fx  (k text primary key, v uuid);
create table tests.num (k text primary key, v int);

-- A real account, through the same auth.users trigger the app uses, so the
-- profile row these tests need exists for the same reason it does in production.
create function tests.mkuser(p_name text) returns uuid
language plpgsql security definer as $$
declare
  v_id uuid := gen_random_uuid();
begin
  insert into auth.users (
    id, instance_id, aud, role, email, encrypted_password,
    email_confirmed_at, created_at, updated_at,
    raw_app_meta_data, raw_user_meta_data
  )
  values (
    v_id, '00000000-0000-0000-0000-000000000000', 'authenticated', 'authenticated',
    p_name || '-' || substr(v_id::text, 1, 8) || '@example.test', '',
    now(), now(), now(),
    '{}'::jsonb, jsonb_build_object('display_name', p_name)
  );
  return v_id;
end $$;

-- An anonymous user still enters through the production new-user trigger, but
-- carries no credentials.  Keep this sibling of mkuser so guest tests exercise
-- the same profile creation path as signInAnonymously().
create function tests.mkguest(p_name text) returns uuid
language plpgsql security definer as $$
declare
  v_id uuid := gen_random_uuid();
begin
  insert into auth.users (
    id, instance_id, aud, role, created_at, updated_at,
    raw_app_meta_data, raw_user_meta_data, is_anonymous
  )
  values (
    v_id, '00000000-0000-0000-0000-000000000000', 'authenticated', 'authenticated', now(), now(),
    '{"provider":"anonymous","providers":["anonymous"]}'::jsonb,
    jsonb_build_object('display_name', p_name), true
  );
  return v_id;
end $$;

-- Become a signed-in player: the JWT claims auth.uid() reads, plus the role
-- that RLS is evaluated against.
create function tests.act_as(p_id uuid) returns void
language plpgsql as $$
begin
  perform set_config(
    'request.jwt.claims',
    json_build_object('sub', p_id::text, 'role', 'authenticated', 'is_anonymous', false)::text,
    true
  );
  perform set_config('role', 'authenticated', true);
end $$;

create function tests.act_as_guest(p_id uuid) returns void
language plpgsql as $$
begin
  perform set_config(
    'request.jwt.claims',
    json_build_object('sub', p_id::text, 'role', 'authenticated', 'is_anonymous', true)::text,
    true
  );
  perform set_config('role', 'authenticated', true);
end $$;

create function tests.act_as_admin() returns void
language plpgsql as $$
begin
  perform set_config('role', 'postgres', true);
  perform set_config('request.jwt.claims', '', true);
end $$;

-- The join code, readable regardless of who the session is acting as. A player
-- about to join by code is by definition not yet a member, so the lobby's own
-- RLS hides the row from them — a lookup inline in a test would silently
-- resolve to NULL rather than fail.
create function tests.lobby_code(p_lobby uuid) returns text
language sql security definer stable as $$
  select code from public.lobbies where id = p_lobby;
$$;

-- A lobby with n members, host first. Returns the lobby id.
create function tests.mklobby(p_users uuid[]) returns uuid
language plpgsql as $$
declare
  v_code  text;
  v_id    uuid;
  v_other uuid;
begin
  perform tests.act_as(p_users[1]);
  select id, code into v_id, v_code from public.create_lobby();

  foreach v_other in array p_users[2:] loop
    perform tests.act_as(v_other);
    perform public.join_lobby(v_code);
  end loop;

  perform tests.act_as(p_users[1]);
  return v_id;
end $$;

-- n fresh players in a fresh room, with a run started and its match dealt into
-- setup. Returns the match id. Leaves the session acting as the host.
create function tests.mkmatch(p_n int, p_game text, out match_id uuid) returns uuid
language plpgsql as $$
declare
  v_users uuid[] := '{}';
  v_lobby uuid;
  v_i     int;
begin
  perform tests.act_as_admin();
  for v_i in 1 .. p_n loop
    v_users := v_users || tests.mkuser('p' || v_i);
  end loop;

  v_lobby := tests.mklobby(v_users);

  perform tests.act_as(v_users[1]);
  select id into match_id from public.start_run(v_lobby, 'arcade', p_game);
end $$;

-- The auction was the only game when this fixture was written, so it keeps the
-- one-argument spelling every existing suite calls.
create function tests.mkmatch(p_n int, out match_id uuid) returns uuid
language plpgsql as $$
begin
  match_id := tests.mkmatch(p_n, 'auction_team_builder');
end $$;

-- One player's own run, no lobby involved, with the match dealt into setup.
-- Returns the match id. Leaves the session acting as that player, the way
-- tests.mkmatch leaves it acting as the host.
create function tests.mksolomatch(p_user uuid, p_game text, out match_id uuid)
returns uuid
language plpgsql as $$
begin
  perform tests.act_as(p_user);
  select id into match_id from public.start_solo_run(p_game);
end $$;

-- A dealt board from a fixed seed, so composition and play can be asserted
-- exactly. Goes through the private dealer rather than start_auction because
-- the seed is deliberately not an argument of the public entry point.
create function tests.deal(p_n int, p_seed double precision, out match_id uuid)
returns uuid
language plpgsql as $$
begin
  match_id := tests.mkmatch(p_n);
  perform tests.act_as_admin();
  perform auction_private.deal_board(match_id, p_seed);
end $$;

create function tests.deal(p_n int, p_seed double precision, p_roster_preset text, out match_id uuid)
returns uuid
language plpgsql as $$
begin
  match_id := tests.mkmatch(p_n);
  perform tests.act_as_admin();
  perform auction_private.deal_board(match_id, p_seed, 'weekly', p_roster_preset);
end $$;

create function tests.deal(p_n int, p_seed double precision, p_scoring_mode text, p_roster_preset text, out match_id uuid)
returns uuid
language plpgsql as $$
begin
  match_id := tests.mkmatch(p_n);
  perform tests.act_as_admin();
  perform auction_private.deal_board(match_id, p_seed, p_scoring_mode, p_roster_preset);
end $$;

-- A dealt board with its first lot opened, ready to be bid on.
create function tests.deal_and_open(p_n int, p_seed double precision, out match_id uuid)
returns uuid
language plpgsql as $$
begin
  match_id := tests.deal(p_n, p_seed);
  perform tests.act_as_admin();
  update public.matches set status = 'playing', started_at = now() where id = match_id;
  perform auction_private.advance(match_id);
  update public.auction_matches am set phase_deadline = now() - interval '1 second'
   where am.match_id = deal_and_open.match_id;
  perform auction_private.expire(match_id);
end $$;

create function tests.deal_and_open(p_n int, p_seed double precision, p_roster_preset text, out match_id uuid)
returns uuid
language plpgsql as $$
begin
  match_id := tests.deal(p_n, p_seed, p_roster_preset);
  perform tests.act_as_admin();
  update public.matches set status = 'playing', started_at = now() where id = match_id;
  perform auction_private.advance(match_id);
  update public.auction_matches am set phase_deadline = now() - interval '1 second' where am.match_id = deal_and_open.match_id;
  perform auction_private.expire(match_id);
end $$;

-- The seat a given player was dealt. Seats are randomised at run start by
-- design (see 0009), so a test that needs a particular player on the clock has
-- to look their seat up. Assuming one passes about half the time.
create function tests.seat_of(p_match_id uuid, p_user uuid) returns smallint
language sql stable as $$
  select seat from public.auction_players
   where match_id = p_match_id and user_id = p_user;
$$;

-- Whoever is on the clock right now.
create function tests.on_clock(p_match_id uuid) returns uuid
language sql stable as $$
  select ap.user_id
    from public.auction_matches am
    join public.auction_players ap
      on ap.match_id = am.match_id and ap.seat = am.turn_seat
   where am.match_id = p_match_id;
$$;

-- The standing price on the lot currently open.
create function tests.price(p_match_id uuid) returns int
language sql stable as $$
  select coalesce(max(b.price), 0)
    from public.auction_bids b
    join public.auction_matches am on am.match_id = b.match_id
   where b.match_id = p_match_id and b.seq = am.current_lot and b.action = 'raise';
$$;

-- Play a dealt board to completion with a scripted strategy.
--
--   pass    everybody always passes
--   raise   everybody raises by 1 whenever they can afford it
--   random  a coin flip per move, deterministic in the match and the seed
--
-- The property under test has to hold regardless of how people bid, which is
-- why the strategy is a parameter rather than a fixed script.
create function tests.play_out(p_match_id uuid, p_strategy text, p_seed int default 1)
returns int
language plpgsql as $$
declare
  v_seat   smallint;
  v_actor  uuid;
  v_budget int;
  v_price  int;
  v_moves  int := 0;
  v_raise  boolean;
  v_phase  text;
begin
  loop
    perform tests.act_as_admin();

    -- A finished board keeps phase = 'sold' with a null phase_deadline, which
    -- is inert in production but not here: this loop forces the deadline into
    -- the past, so without this exit it would drive current_lot past the end of
    -- the board forever and die on smallint overflow rather than on the guard.
    exit when (select status from public.matches where id = p_match_id)
              <> 'playing'::public.match_status;

    select turn_seat, phase into v_seat, v_phase
      from public.auction_matches where match_id = p_match_id;

    -- Timer-off phases are counted as moves too. They advance real state, so
    -- leaving them outside the guard is what let the runaway above go unbounded.
    if v_seat is null then
      if v_phase in ('lot_preview', 'sold') then
        v_moves := v_moves + 1;
        if v_moves > 5000 then
          raise exception 'play_out did not terminate after % moves', v_moves;
        end if;
        update public.auction_matches set phase_deadline = now() - interval '1 second' where match_id = p_match_id;
        perform auction_private.expire(p_match_id);
        continue;
      end if;
      exit;
    end if;

    v_moves := v_moves + 1;
    if v_moves > 5000 then
      raise exception 'play_out did not terminate after % moves', v_moves;
    end if;

    select ap.user_id, ap.budget into v_actor, v_budget
      from public.auction_players ap
     where ap.match_id = p_match_id and ap.seat = v_seat;

    v_price := tests.price(p_match_id);

    if p_strategy = 'pass' then
      v_raise := false;
    elsif p_strategy = 'raise' then
      v_raise := v_budget >= v_price + 1;
    elsif p_strategy = 'random' then
      v_raise := v_budget >= v_price + 1
             and (get_byte(decode(md5(p_match_id::text || v_moves || p_seed), 'hex'), 0) % 2) = 0;
    else
      raise exception 'unknown strategy %', p_strategy;
    end if;

    perform tests.act_as(v_actor);
    if v_raise then
      perform auction.place_bid(p_match_id, v_price + 1);
    else
      perform auction.pass_lot(p_match_id);
    end if;
  end loop;

  perform tests.act_as_admin();
  return v_moves;
end $$;

-- Every seat, every configured slot. Returns both shortages and overfills —
-- either result means the count-based eligibility rule has broken the deal.
create function tests.stranded(p_match_id uuid) returns text[]
language sql stable as $$
  select coalesce(array_agg(ap.seat || ':' || s.slot order by ap.seat, s.slot), '{}'::text[])
    from public.auction_players ap
    join public.auction_matches am on am.match_id = ap.match_id
    cross join lateral unnest(array['QB','RB','WR','TE','FLEX']) s(slot)
    left join lateral (
      select count(*)::int as won from public.auction_lots l
       where l.match_id = p_match_id and l.winner_id = ap.user_id and l.slot = s.slot
    ) w on true
   where ap.match_id = p_match_id and w.won <> case s.slot when 'QB' then am.qb_slots when 'RB' then am.rb_slots when 'WR' then am.wr_slots when 'TE' then am.te_slots else am.flex_slots end;
$$;

-- ------------------------------------------------------- higher or lower --

-- A dealt Higher or Lower ladder from a fixed seed, so the board can be
-- asserted exactly. Goes through the private dealer rather than
-- higher_or_lower.start because the seed is deliberately not an argument of the
-- public entry point.
--
-- Scoring mode and era window are arguments rather than a second helper: they
-- are the two things a board's shape depends on, and a suite that wants a
-- narrow window should not have to build the match itself to get one.
create function tests.deal_higher_or_lower(
  p_n int,
  p_seed double precision,
  p_scoring_mode text default 'season_total',
  p_season_from smallint default null,
  p_season_to smallint default null,
  out match_id uuid
)
returns uuid
language plpgsql as $$
begin
  match_id := tests.mkmatch(p_n, 'higher_or_lower');
  perform tests.act_as_admin();
  perform higher_or_lower_private.deal_board(
    match_id, p_seed, p_scoring_mode, p_season_from, p_season_to
  );
end $$;

-- The solo counterpart: one player's own run rather than a lobby's, otherwise
-- dealt the same way.
create function tests.deal_solo_higher_or_lower(
  p_user uuid,
  p_seed double precision,
  p_scoring_mode text default 'season_total',
  p_season_from smallint default null,
  p_season_to smallint default null,
  out match_id uuid
)
returns uuid
language plpgsql as $$
begin
  match_id := tests.mksolomatch(p_user, 'higher_or_lower');
  perform tests.act_as_admin();
  perform higher_or_lower_private.deal_board(
    match_id, p_seed, p_scoring_mode, p_season_from, p_season_to
  );
end $$;

-- Put a board on a live call phase without waiting out the intro, the way the
-- clock would. The presence window opens now, so a tick taken during the test
-- counts as a tick during this question — a fixture that skipped that would
-- latch every player absent at the first reveal.
create function tests.open_question(p_match_id uuid, p_question smallint default 1)
returns void
language plpgsql as $$
begin
  update public.higher_or_lower_matches
     set current_question   = p_question,
         phase              = 'call',
         phase_deadline     = now() + interval '1 minute',
         question_started_at = now()
   where match_id = p_match_id;
end $$;

-- The direction that is right for a question, read from the hidden answers.
--
-- Definer because a test asserting on scoring has to know the answer while
-- acting as a player who by definition may not. Reading the public cards
-- instead would only work once the question had already revealed, which is
-- after the moment most of these assertions care about.
create function tests.hol_answer(p_match_id uuid, p_question smallint) returns text
language sql stable security definer as $$
  select case when challenger.points > anchor.points then 'higher' else 'lower' end
    from higher_or_lower_private.answers anchor
    join higher_or_lower_private.answers challenger
      on challenger.match_id = anchor.match_id
     and challenger.ordinal = anchor.ordinal + 1
   where anchor.match_id = p_match_id and anchor.ordinal = p_question - 1;
$$;

-- The other one. A wrong call has to be wrong on purpose, not by luck.
create function tests.hol_wrong_answer(p_match_id uuid, p_question smallint) returns text
language sql stable as $$
  select case tests.hol_answer(p_match_id, p_question) when 'higher' then 'lower' else 'higher' end;
$$;

-- Force the phase deadline past and let the server take exactly one transition,
-- which is what a client's tick would have caused a moment later.
create function tests.hol_expire(p_match_id uuid) returns void
language plpgsql as $$
begin
  update public.higher_or_lower_matches
     set phase_deadline = now() - interval '1 second'
   where match_id = p_match_id;
  perform higher_or_lower_private.expire(p_match_id);
end $$;

-- ------------------------------------------------------------ sabotage draft --

-- A dealt sabotage draft match from a fixed seed, so the fourteen team spins
-- can be asserted exactly. Goes through the private dealer rather than
-- sabotage_draft.start because the seed is deliberately not an argument of
-- the public entry point.
create function tests.deal_sabotage_draft(p_n int, p_seed double precision, out match_id uuid)
returns uuid
language plpgsql as $$
begin
  match_id := tests.mkmatch(p_n, 'sabotage_draft');
  perform tests.act_as_admin();
  perform sabotage_draft_private.deal_board(match_id, p_seed);
end $$;

-- Force the current turn's shared clock past and let the server take
-- exactly one expiry, the same shape as tests.hol_expire. Since 0063, a turn
-- has one clock covering both the active seat's pick and everyone else's
-- guess-or-pass, and expire() resolves and advances the whole turn in this
-- one call — there is no second phase left to force separately.
create function tests.sd_expire(p_match_id uuid) returns void
language plpgsql as $$
begin
  update public.sabotage_draft_matches
     set turn_deadline = now() - interval '1 second'
   where match_id = p_match_id;
  perform sabotage_draft_private.expire(p_match_id);
end $$;

-- Kept as an alias: pre-0063 tests fast-forwarded a whole turn in two calls
-- (a pick-timeout expiry, then a separate guess-window expiry). One shared
-- clock collapses that into the single call tests.sd_expire already makes.
create function tests.sd_expire_turn(p_match_id uuid) returns void
language plpgsql as $$
begin
  perform tests.sd_expire(p_match_id);
end $$;

-- The seat currently on the clock. Definer for the same reason
-- sd_pick_candidate is: a test acting as a player should not need its own
-- grant on the engine schema just to ask a convenience question the match
-- already answers publicly via sabotage_draft.state.
create function tests.sd_active_user(p_match_id uuid) returns uuid
language sql stable security definer as $$
  select sp.user_id
    from public.sabotage_draft_matches sm
    join public.sabotage_draft_players sp
      on sp.match_id = sm.match_id and sp.seat = sm.active_seat
   where sm.match_id = p_match_id;
$$;

-- A real, valid pick for a round: a player id and season that this player's
-- own spun franchise and the given category actually contain. Definer,
-- because a test acting as a player has to source an honest submit_pick
-- argument without itself holding a select grant on private.av_roster_players
-- — correctly, it has none, the same reason tests.hol_answer is definer.
create function tests.sd_pick_candidate(
  p_match_id uuid, p_round smallint, p_user_id uuid, p_category text,
  out player_id text, out season smallint
)
language sql stable security definer as $$
  select p.player_id, p.season
    from private.av_roster_players p
    join public.sabotage_draft_round_spins s on s.franchise_code = p.franchise_code
   where s.match_id = p_match_id and s.round_number = p_round and s.user_id = p_user_id
     and p.slot_category = p_category
   order by p.player_id
   limit 1;
$$;

-- Two distinct real franchise codes at a category, so a test can force two
-- players onto provably different pools instead of hoping a seed happens to
-- deal them one. Definer for the same reason sd_pick_candidate is.
create function tests.sd_distinct_franchises(p_category text, out f1 text, out f2 text)
returns record
language sql stable security definer as $$
  select min(franchise_code), max(franchise_code)
    from private.av_roster_players where slot_category = p_category;
$$;

-- A real player with at least two seasons in the same franchise/category
-- pool, plus two of those seasons named explicitly -- so a test that needs
-- the name-only-guess respin's same-player-different-year branch to
-- actually fire doesn't have to hope the seed happens to deal one. Definer
-- for the same reason sd_pick_candidate is.
create function tests.sd_multi_season_player(
  p_category text, out franchise_code text, out player_id text, out season1 smallint, out season2 smallint
)
language sql stable security definer as $$
  select p.franchise_code, p.player_id, min(p.season), max(p.season)
    from private.av_roster_players p
   where p.slot_category = p_category
   group by p.franchise_code, p.player_id
  having count(*) >= 2
   order by p.franchise_code, p.player_id
   limit 1;
$$;

-- The counterpart: a real player with exactly one season in their
-- franchise/category pool, so a test can exercise the "no other year to
-- respin to" no-op case deliberately rather than stumbling into it.
-- Definer for the same reason sd_pick_candidate is.
create function tests.sd_single_season_player(
  p_category text, out franchise_code text, out player_id text, out season smallint
)
language sql stable security definer as $$
  select p.franchise_code, p.player_id, min(p.season)
    from private.av_roster_players p
   where p.slot_category = p_category
   group by p.franchise_code, p.player_id
  having count(*) = 1
   order by p.franchise_code, p.player_id
   limit 1;
$$;

grant usage on schema tests to authenticated;
grant execute on all functions in schema tests to authenticated;
grant all on all tables in schema tests to authenticated;
