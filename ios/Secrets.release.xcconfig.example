// Copy to Secrets.release.xcconfig (gitignored) and fill in with your HOSTED
// Supabase project — same values as the production webapp env. Only Release
// builds (Archive / TestFlight) read this file; Debug builds keep using
// Secrets.xcconfig, which points at the local `supabase start` stack.
//
// The "$()" in the URL is not a typo — see Secrets.xcconfig.example.
SUPABASE_URL = https:/$()/project-ref.supabase.co
SUPABASE_ANON_KEY =
