<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.ballparty.app.oauth-callback</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<!-- Keep in sync with SupabaseConfig.oauthCallbackScheme. -->
				<string>com.ballparty.app</string>
			</array>
		</dict>
	</array>
	<key>UIAppFonts</key>
	<array>
		<string>BebasNeue-Regular.ttf</string>
		<string>Barlow-Regular.ttf</string>
		<string>Barlow-Medium.ttf</string>
		<string>Barlow-SemiBold.ttf</string>
		<string>Barlow-Bold.ttf</string>
		<string>JetBrainsMono-Regular.ttf</string>
		<string>JetBrainsMono-Bold.ttf</string>
	</array>
	<!-- Dark only, like the web app: there is no light theme to fall back to. -->
	<key>UIUserInterfaceStyle</key>
	<string>Dark</string>
	<key>SUPABASE_URL</key>
	<string>$(SUPABASE_URL)</string>
	<key>SUPABASE_ANON_KEY</key>
	<string>$(SUPABASE_ANON_KEY)</string>
</dict>
</plist>
