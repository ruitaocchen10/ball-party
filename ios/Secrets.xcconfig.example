// Copy to Secrets.xcconfig (gitignored) and fill in — same values as
// webapp/.env.example. For local development against the Supabase stack
// started by `supabase start`, use the same URL/key webapp/.env.local uses;
// the iOS Simulator shares the Mac's network, so 127.0.0.1 resolves fine
// there (a physical device needs your Mac's LAN IP instead).
//
// The "$()" in the URL below is not a typo — Xcode's xcconfig format treats
// a bare "//" as a start-of-line comment, so it has to be split up.
SUPABASE_URL = https:/$()/project-ref.supabase.co
SUPABASE_ANON_KEY =

